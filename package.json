{
  "name": "@keumbang/openapi-mcp",
  "version": "0.1.0",
  "description": "금방(Keumbang) Open API 코딩 어시스턴트 MCP 서버 — 스펙 조회 · JWT 서명 코드 생성 · 로컬 서명/검증",
  "license": "MIT",
  "type": "module",
  "bin": {
    "keumbang-openapi-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "spec"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "sync-spec": "node scripts/sync-spec.mjs",
    "start": "node dist/index.js",
    "test": "node --test dist/*.test.js || node --test",
    "prepublishOnly": "npm run sync-spec && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
